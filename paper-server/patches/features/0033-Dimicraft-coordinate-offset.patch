@@ -23,23 +23,33 @@ public record ClientboundExplodePacket(
     Holder<SoundEvent> explosionSound,
     WeightedList<ExplosionParticleInfo> blockParticles
 ) implements Packet<ClientGamePacketListener> {
-    public static final StreamCodec<RegistryFriendlyByteBuf, ClientboundExplodePacket> STREAM_CODEC = StreamCodec.composite(
-        Vec3.STREAM_CODEC,
-        ClientboundExplodePacket::center,
-        ByteBufCodecs.FLOAT,
-        ClientboundExplodePacket::radius,
-        ByteBufCodecs.INT,
-        ClientboundExplodePacket::blockCount,
-        Vec3.STREAM_CODEC.apply(ByteBufCodecs::optional),
-        ClientboundExplodePacket::playerKnockback,
-        ParticleTypes.STREAM_CODEC,
-        ClientboundExplodePacket::explosionParticle,
-        SoundEvent.STREAM_CODEC,
-        ClientboundExplodePacket::explosionSound,
-        WeightedList.streamCodec(ExplosionParticleInfo.STREAM_CODEC),
-        ClientboundExplodePacket::blockParticles,
-        ClientboundExplodePacket::new
+    private static final StreamCodec<RegistryFriendlyByteBuf, WeightedList<ExplosionParticleInfo>> BLOCK_PARTICLES_STREAM_CODEC = WeightedList.streamCodec(
+        ExplosionParticleInfo.STREAM_CODEC
     );
+    public static final StreamCodec<RegistryFriendlyByteBuf, ClientboundExplodePacket> STREAM_CODEC = Packet.codec(
+        ClientboundExplodePacket::write, ClientboundExplodePacket::read
+    );
+
+    private static ClientboundExplodePacket read(final RegistryFriendlyByteBuf input) {
+        Vec3 center = DimicraftCoordinateOffset.toServerPosition(Vec3.STREAM_CODEC.decode(input));
+        float radius = input.readFloat();
+        int blockCount = input.readInt();
+        Optional<Vec3> playerKnockback = input.readOptional(Vec3.STREAM_CODEC::decode);
+        ParticleOptions explosionParticle = ParticleTypes.STREAM_CODEC.decode(input);
+        Holder<SoundEvent> explosionSound = SoundEvent.STREAM_CODEC.decode(input);
+        WeightedList<ExplosionParticleInfo> blockParticles = BLOCK_PARTICLES_STREAM_CODEC.decode(input);
+        return new ClientboundExplodePacket(center, radius, blockCount, playerKnockback, explosionParticle, explosionSound, blockParticles);
+    }
+
+    private void write(final RegistryFriendlyByteBuf output) {
+        Vec3.STREAM_CODEC.encode(output, DimicraftCoordinateOffset.toClientPosition(this.center));
+        output.writeFloat(this.radius);
+        output.writeInt(this.blockCount);
+        output.writeOptional(this.playerKnockback, (o, pos) -> Vec3.STREAM_CODEC.encode(o, pos));
+        ParticleTypes.STREAM_CODEC.encode(output, this.explosionParticle);
+        SoundEvent.STREAM_CODEC.encode(output, this.explosionSound);
+        BLOCK_PARTICLES_STREAM_CODEC.encode(output, this.blockParticles);
+    }
 
     @Override
     public PacketType<ClientboundExplodePacket> type() {
