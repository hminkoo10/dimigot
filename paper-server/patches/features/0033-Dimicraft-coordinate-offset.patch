new file mode 100644
index 0000000..ecb62db
--- /dev/null
+++ b/io/papermc/paper/dimicraft/DimicraftCoordinateOffset.java
@@ -0,0 +1,262 @@
+package io.papermc.paper.dimicraft;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.SectionPos;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.phys.Vec3;
+
+import java.security.SecureRandom;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+
+public final class DimicraftCoordinateOffset {
+    private static final String ENABLED_PROPERTY = "dimicraft.coordinateOffset.enabled";
+    private static final String X_PROPERTY = "dimicraft.coordinateOffset.x";
+    private static final String Z_PROPERTY = "dimicraft.coordinateOffset.z";
+    private static final String SECRET_PROPERTY = "dimicraft.coordinateOffset.secret";
+    private static final String ENABLED_ENV = "DIMICRAFT_COORDINATE_OFFSET_ENABLED";
+    private static final String X_ENV = "DIMICRAFT_COORDINATE_OFFSET_X";
+    private static final String Z_ENV = "DIMICRAFT_COORDINATE_OFFSET_Z";
+    private static final String SECRET_ENV = "DIMICRAFT_COORDINATE_OFFSET_SECRET";
+    private static final int PLAYER_OFFSET_RANGE = 2_000_000;
+    private static final int SOUND_POSITION_SCALE = 8;
+    private static final Offset ZERO_OFFSET = new Offset(0, 0);
+    private static final ThreadLocal<UUID> CURRENT_PLAYER_ID = new ThreadLocal<>();
+    private static final ConcurrentMap<UUID, Offset> PLAYER_OFFSETS = new ConcurrentHashMap<>();
+    private static final SecureRandom OFFSET_RANDOM = new SecureRandom();
+
+    private static volatile boolean enabled;
+    private static volatile Offset fallbackOffset = ZERO_OFFSET;
+    private static volatile String secret = "dimicraft";
+
+    static {
+        reloadFromProperties();
+    }
+
+    private DimicraftCoordinateOffset() {
+    }
+
+    public static void reloadFromProperties() {
+        configure(
+            readBoolean(ENABLED_PROPERTY, ENABLED_ENV, false),
+            readInt(X_PROPERTY, X_ENV, 0),
+            readInt(Z_PROPERTY, Z_ENV, 0),
+            readString(SECRET_PROPERTY, SECRET_ENV, "dimicraft")
+        );
+    }
+
+    public static void configure(final boolean enabled, final int rawBlockOffsetX, final int rawBlockOffsetZ) {
+        configure(enabled, rawBlockOffsetX, rawBlockOffsetZ, DimicraftCoordinateOffset.secret);
+    }
+
+    public static void configure(final boolean enabled, final int rawBlockOffsetX, final int rawBlockOffsetZ, final String secret) {
+        DimicraftCoordinateOffset.enabled = enabled;
+        DimicraftCoordinateOffset.fallbackOffset = new Offset(alignToSection(rawBlockOffsetX), alignToSection(rawBlockOffsetZ));
+        DimicraftCoordinateOffset.secret = secret == null || secret.isBlank() ? "dimicraft" : secret;
+        DimicraftCoordinateOffset.PLAYER_OFFSETS.clear();
+    }
+
+    public static void pushPlayer(final UUID playerId) {
+        if (playerId == null) {
+            CURRENT_PLAYER_ID.remove();
+        } else {
+            CURRENT_PLAYER_ID.set(playerId);
+        }
+    }
+
+    public static void clearPlayer() {
+        CURRENT_PLAYER_ID.remove();
+    }
+
+    /**
+     * Discards the stored offset so the next session gets a fresh random one.
+     * Must be called before login completes, while no play packets are in flight.
+     */
+    public static void rotatePlayer(final UUID playerId) {
+        if (playerId != null) {
+            PLAYER_OFFSETS.remove(playerId);
+        }
+    }
+
+    public static boolean enabled() {
+        return enabled;
+    }
+
+    public static int blockOffsetX() {
+        return currentOffset().blockX;
+    }
+
+    public static int blockOffsetZ() {
+        return currentOffset().blockZ;
+    }
+
+    public static double toClientX(final double x) {
+        return x + currentOffset().blockX;
+    }
+
+    public static double toClientZ(final double z) {
+        return z + currentOffset().blockZ;
+    }
+
+    public static double toServerX(final double x) {
+        return x - currentOffset().blockX;
+    }
+
+    public static double toServerZ(final double z) {
+        return z - currentOffset().blockZ;
+    }
+
+    public static int toClientBlockX(final int x) {
+        return x + currentOffset().blockX;
+    }
+
+    public static int toClientBlockZ(final int z) {
+        return z + currentOffset().blockZ;
+    }
+
+    public static int toServerBlockX(final int x) {
+        return x - currentOffset().blockX;
+    }
+
+    public static int toServerBlockZ(final int z) {
+        return z - currentOffset().blockZ;
+    }
+
+    public static int toClientChunkX(final int x) {
+        return x + currentOffset().sectionX;
+    }
+
+    public static int toClientChunkZ(final int z) {
+        return z + currentOffset().sectionZ;
+    }
+
+    public static int toServerChunkX(final int x) {
+        return x - currentOffset().sectionX;
+    }
+
+    public static int toServerChunkZ(final int z) {
+        return z - currentOffset().sectionZ;
+    }
+
+    public static int toClientSoundX(final int x) {
+        return x + currentOffset().scaledSoundX;
+    }
+
+    public static int toClientSoundZ(final int z) {
+        return z + currentOffset().scaledSoundZ;
+    }
+
+    public static int toServerSoundX(final int x) {
+        return x - currentOffset().scaledSoundX;
+    }
+
+    public static int toServerSoundZ(final int z) {
+        return z - currentOffset().scaledSoundZ;
+    }
+
+    public static BlockPos toClientBlockPos(final BlockPos pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? new BlockPos(pos.getX() + offset.blockX, pos.getY(), pos.getZ() + offset.blockZ) : pos;
+    }
+
+    public static BlockPos toServerBlockPos(final BlockPos pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? new BlockPos(pos.getX() - offset.blockX, pos.getY(), pos.getZ() - offset.blockZ) : pos;
+    }
+
+    public static ChunkPos toClientChunkPos(final ChunkPos pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? new ChunkPos(pos.x() + offset.sectionX, pos.z() + offset.sectionZ) : pos;
+    }
+
+    public static ChunkPos toServerChunkPos(final ChunkPos pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? new ChunkPos(pos.x() - offset.sectionX, pos.z() - offset.sectionZ) : pos;
+    }
+
+    public static SectionPos toClientSectionPos(final SectionPos pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? SectionPos.of(pos.x() + offset.sectionX, pos.y(), pos.z() + offset.sectionZ) : pos;
+    }
+
+    public static SectionPos toServerSectionPos(final SectionPos pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? SectionPos.of(pos.x() - offset.sectionX, pos.y(), pos.z() - offset.sectionZ) : pos;
+    }
+
+    public static Vec3 toClientPosition(final Vec3 pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? new Vec3(pos.x + offset.blockX, pos.y, pos.z + offset.blockZ) : pos;
+    }
+
+    public static Vec3 toServerPosition(final Vec3 pos) {
+        Offset offset = currentOffset();
+        return offset.enabled() ? new Vec3(pos.x - offset.blockX, pos.y, pos.z - offset.blockZ) : pos;
+    }
+
+    private static Offset currentOffset() {
+        if (!enabled) {
+            return ZERO_OFFSET;
+        }
+        UUID playerId = CURRENT_PLAYER_ID.get();
+        return playerId == null ? fallbackOffset : PLAYER_OFFSETS.computeIfAbsent(playerId, DimicraftCoordinateOffset::createPlayerOffset);
+    }
+
+    // Random per session: entries are evicted at login via rotatePlayer, so every connection sees fresh coordinates.
+    private static Offset createPlayerOffset(final UUID playerId) {
+        int sectionRange = Math.max(1, PLAYER_OFFSET_RANGE >> 4);
+        int sectionX = (fallbackOffset.blockX >> 4) + boundedSectionOffset(OFFSET_RANDOM.nextInt(), sectionRange);
+        int sectionZ = (fallbackOffset.blockZ >> 4) + boundedSectionOffset(OFFSET_RANDOM.nextInt(), sectionRange);
+        return new Offset(sectionX << 4, sectionZ << 4);
+    }
+
+    private static int boundedSectionOffset(final int value, final int sectionRange) {
+        return Math.floorMod(value, sectionRange * 2 + 1) - sectionRange;
+    }
+
+    private static int alignToSection(final int value) {
+        return Math.floorDiv(value, 16) * 16;
+    }
+
+    private static boolean readBoolean(final String property, final String env, final boolean fallback) {
+        String value = System.getProperty(property);
+        if (value == null || value.isBlank()) {
+            value = System.getenv(env);
+        }
+        return value == null || value.isBlank() ? fallback : Boolean.parseBoolean(value);
+    }
+
+    private static int readInt(final String property, final String env, final int fallback) {
+        String value = System.getProperty(property);
+        if (value == null || value.isBlank()) {
+            value = System.getenv(env);
+        }
+        if (value == null || value.isBlank()) {
+            return fallback;
+        }
+        try {
+            return Integer.parseInt(value.trim());
+        } catch (final NumberFormatException ignored) {
+            return fallback;
+        }
+    }
+
+    private static String readString(final String property, final String env, final String fallback) {
+        String value = System.getProperty(property);
+        if (value == null || value.isBlank()) {
+            value = System.getenv(env);
+        }
+        return value == null || value.isBlank() ? fallback : value;
+    }
+
+    private record Offset(int blockX, int blockZ, int sectionX, int sectionZ, int scaledSoundX, int scaledSoundZ) {
+        private Offset(final int blockX, final int blockZ) {
+            this(blockX, blockZ, blockX >> 4, blockZ >> 4, blockX * SOUND_POSITION_SCALE, blockZ * SOUND_POSITION_SCALE);
+        }
+
+        private boolean enabled() {
+            return this.blockX != 0 || this.blockZ != 0;
+        }
+    }
+}
