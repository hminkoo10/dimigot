index 0000000000000000000000000000000000000000..23fbb219fc1bcfb8a14925b788d4dd776b8f1b21
--- /dev/null
+++ b/io/papermc/paper/dimicraft/DimicraftCoordinateOffset.java
@@ -0,0 +1,184 @@
+package io.papermc.paper.dimicraft;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.SectionPos;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.phys.Vec3;
+
+public final class DimicraftCoordinateOffset {
+    private static final String ENABLED_PROPERTY = "dimicraft.coordinateOffset.enabled";
+    private static final String X_PROPERTY = "dimicraft.coordinateOffset.x";
+    private static final String Z_PROPERTY = "dimicraft.coordinateOffset.z";
+    private static final String ENABLED_ENV = "DIMICRAFT_COORDINATE_OFFSET_ENABLED";
+    private static final String X_ENV = "DIMICRAFT_COORDINATE_OFFSET_X";
+    private static final String Z_ENV = "DIMICRAFT_COORDINATE_OFFSET_Z";
+    private static final int SOUND_POSITION_SCALE = 8;
+
+    private static volatile boolean enabled;
+    private static volatile int blockOffsetX;
+    private static volatile int blockOffsetZ;
+    private static volatile int sectionOffsetX;
+    private static volatile int sectionOffsetZ;
+    private static volatile int scaledSoundOffsetX;
+    private static volatile int scaledSoundOffsetZ;
+
+    static {
+        reloadFromProperties();
+    }
+
+    private DimicraftCoordinateOffset() {
+    }
+
+    public static void reloadFromProperties() {
+        configure(
+            readBoolean(ENABLED_PROPERTY, ENABLED_ENV, false),
+            readInt(X_PROPERTY, X_ENV, 0),
+            readInt(Z_PROPERTY, Z_ENV, 0)
+        );
+    }
+
+    public static void configure(final boolean enabled, final int rawBlockOffsetX, final int rawBlockOffsetZ) {
+        DimicraftCoordinateOffset.enabled = enabled;
+        DimicraftCoordinateOffset.blockOffsetX = alignToSection(rawBlockOffsetX);
+        DimicraftCoordinateOffset.blockOffsetZ = alignToSection(rawBlockOffsetZ);
+        DimicraftCoordinateOffset.sectionOffsetX = DimicraftCoordinateOffset.blockOffsetX >> 4;
+        DimicraftCoordinateOffset.sectionOffsetZ = DimicraftCoordinateOffset.blockOffsetZ >> 4;
+        DimicraftCoordinateOffset.scaledSoundOffsetX = DimicraftCoordinateOffset.blockOffsetX * SOUND_POSITION_SCALE;
+        DimicraftCoordinateOffset.scaledSoundOffsetZ = DimicraftCoordinateOffset.blockOffsetZ * SOUND_POSITION_SCALE;
+    }
+
+    public static boolean enabled() {
+        return enabled;
+    }
+
+    public static int blockOffsetX() {
+        return blockOffsetX;
+    }
+
+    public static int blockOffsetZ() {
+        return blockOffsetZ;
+    }
+
+    public static double toClientX(final double x) {
+        return enabled ? x + blockOffsetX : x;
+    }
+
+    public static double toClientZ(final double z) {
+        return enabled ? z + blockOffsetZ : z;
+    }
+
+    public static double toServerX(final double x) {
+        return enabled ? x - blockOffsetX : x;
+    }
+
+    public static double toServerZ(final double z) {
+        return enabled ? z - blockOffsetZ : z;
+    }
+
+    public static int toClientBlockX(final int x) {
+        return enabled ? x + blockOffsetX : x;
+    }
+
+    public static int toClientBlockZ(final int z) {
+        return enabled ? z + blockOffsetZ : z;
+    }
+
+    public static int toServerBlockX(final int x) {
+        return enabled ? x - blockOffsetX : x;
+    }
+
+    public static int toServerBlockZ(final int z) {
+        return enabled ? z - blockOffsetZ : z;
+    }
+
+    public static int toClientChunkX(final int x) {
+        return enabled ? x + sectionOffsetX : x;
+    }
+
+    public static int toClientChunkZ(final int z) {
+        return enabled ? z + sectionOffsetZ : z;
+    }
+
+    public static int toServerChunkX(final int x) {
+        return enabled ? x - sectionOffsetX : x;
+    }
+
+    public static int toServerChunkZ(final int z) {
+        return enabled ? z - sectionOffsetZ : z;
+    }
+
+    public static int toClientSoundX(final int x) {
+        return enabled ? x + scaledSoundOffsetX : x;
+    }
+
+    public static int toClientSoundZ(final int z) {
+        return enabled ? z + scaledSoundOffsetZ : z;
+    }
+
+    public static int toServerSoundX(final int x) {
+        return enabled ? x - scaledSoundOffsetX : x;
+    }
+
+    public static int toServerSoundZ(final int z) {
+        return enabled ? z - scaledSoundOffsetZ : z;
+    }
+
+    public static BlockPos toClientBlockPos(final BlockPos pos) {
+        return enabled ? new BlockPos(pos.getX() + blockOffsetX, pos.getY(), pos.getZ() + blockOffsetZ) : pos;
+    }
+
+    public static BlockPos toServerBlockPos(final BlockPos pos) {
+        return enabled ? new BlockPos(pos.getX() - blockOffsetX, pos.getY(), pos.getZ() - blockOffsetZ) : pos;
+    }
+
+    public static ChunkPos toClientChunkPos(final ChunkPos pos) {
+        return enabled ? new ChunkPos(pos.x() + sectionOffsetX, pos.z() + sectionOffsetZ) : pos;
+    }
+
+    public static ChunkPos toServerChunkPos(final ChunkPos pos) {
+        return enabled ? new ChunkPos(pos.x() - sectionOffsetX, pos.z() - sectionOffsetZ) : pos;
+    }
+
+    public static SectionPos toClientSectionPos(final SectionPos pos) {
+        return enabled ? SectionPos.of(pos.x() + sectionOffsetX, pos.y(), pos.z() + sectionOffsetZ) : pos;
+    }
+
+    public static SectionPos toServerSectionPos(final SectionPos pos) {
+        return enabled ? SectionPos.of(pos.x() - sectionOffsetX, pos.y(), pos.z() - sectionOffsetZ) : pos;
+    }
+
+    public static Vec3 toClientPosition(final Vec3 pos) {
+        return enabled ? new Vec3(pos.x + blockOffsetX, pos.y, pos.z + blockOffsetZ) : pos;
+    }
+
+    public static Vec3 toServerPosition(final Vec3 pos) {
+        return enabled ? new Vec3(pos.x - blockOffsetX, pos.y, pos.z - blockOffsetZ) : pos;
+    }
+
+    private static int alignToSection(final int value) {
+        return Math.floorDiv(value, 16) * 16;
+    }
+
+    private static boolean readBoolean(final String property, final String env, final boolean fallback) {
+        String value = System.getProperty(property);
+        if (value == null || value.isBlank()) {
+            value = System.getenv(env);
+        }
+        return value == null || value.isBlank() ? fallback : Boolean.parseBoolean(value);
+    }
+
+    private static int readInt(final String property, final String env, final int fallback) {
+        String value = System.getProperty(property);
+        if (value == null || value.isBlank()) {
+            value = System.getenv(env);
+        }
+        if (value == null || value.isBlank()) {
+            return fallback;
+        }
+        try {
+            return Integer.parseInt(value.trim());
+        } catch (final NumberFormatException ignored) {
+            return fallback;
+        }
+    }
+}
